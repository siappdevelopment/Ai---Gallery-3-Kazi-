<?xml version="1.0" encoding="utf-8"?>
<!-- The ad's card: its own fill and a clear border so it does not melt into the screen behind it -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/ad_background" />
    <stroke android:width="1dp" android:color="@color/ad_border" />
    <corners android:radius="12dp" />
</shape>
