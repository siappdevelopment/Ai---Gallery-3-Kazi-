<?xml version="1.0" encoding="utf-8"?>
<!-- The selected radio button of the system list, in the app's pink: a ring around a dot. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/brand_pink" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/brand_pink" />
        </shape>
    </item>
</layer-list>
