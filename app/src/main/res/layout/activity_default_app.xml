<?xml version="1.0" encoding="utf-8"?>
<!-- Default app (design 07): the system launcher choice, then Set as Default -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onb_background"
    tools:context=".activity.DefaultAppActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideSheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.36" />

    <!-- The mini phone: the choice the system is about to ask -->
    <FrameLayout
        android:id="@+id/phone"
        android:layout_width="238dp"
        android:layout_height="330dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_onb_phone"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onb_time"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_onb_camera_dot" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitEnd"
                    android:src="@drawable/ic_signal_cellular"
                    app:tint="@color/splash_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="6dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_splash_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/app_name"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_onb_tile_orange"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/ic_grid_view"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="@string/onb_opt_other_launcher"
                        android:textColor="@color/onb_option_text"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_onb_radio_off" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="44dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_onb_tile_blue"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/ic_home_filled"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="@string/onb_opt_system_launcher"
                        android:textColor="@color/onb_option_text"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_onb_radio_off" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- The chosen option, raised over the phone -->
    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="290dp"
        android:layout_height="56dp"
        android:layout_marginTop="162dp"
        android:background="@drawable/bg_onb_pill"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_splash_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/onb_opt_gallery_app"
            android:textColor="@color/splash_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_onb_radio_on" />
    </LinearLayout>

    <!-- Title, description, the button, and the reserved ad area (40% of the screen) -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_onb_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideSheet">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.375"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="-0.027"
                android:text="@string/onb_default_title"
                android:textColor="@color/splash_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.1"
                android:text="@string/onb_default_desc"
                android:textColor="@color/onb_desc"
                android:textSize="13sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetDefault"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/default_set"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_pink"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="6dp"
                app:iconSize="19dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.625"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_intro_ad_placeholder">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:letterSpacing="0.07"
                    android:padding="8dp"
                    android:text="@string/intro1_ad_placeholder"
                    android:textColor="@color/intro_ad_label"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
