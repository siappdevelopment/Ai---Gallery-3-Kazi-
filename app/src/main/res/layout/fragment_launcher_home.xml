<?xml version="1.0" encoding="utf-8"?>
<!-- Home page: search bar, clock + shortcut cards, folders, dock. Drawn over the wallpaper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/homeRoot"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llGoogleSearch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_margin="@dimen/_12sdp"
        android:background="@drawable/lh_custom_radius_12"
        android:backgroundTint="@color/lh_bg"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:importantForAccessibility="no"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/lh_ic_google" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:layout_weight="1"
            android:fontFamily="@font/sans_trial_medium"
            android:paddingBottom="@dimen/_2sdp"
            android:text="@string/launcher_google_search"
            android:textColor="@color/lh_text_primary"
            android:textSize="@dimen/_13sdp" />

        <ImageView
            android:id="@+id/ivGoogleVoiceSearch"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:contentDescription="@string/launcher_voice_search"
            android:padding="@dimen/_2sdp"
            android:src="@drawable/lh_ic_google_voice" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:background="@drawable/lh_custom_radius_12"
        android:backgroundTint="@color/lh_bg"
        android:gravity="center_vertical"
        android:padding="@dimen/_12sdp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_6sdp">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sans_trial_semi_bold"
                android:textColor="@color/lh_text_primary"
                android:textSize="@dimen/_32sdp" />

            <TextView
                android:id="@+id/tvDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/sans_trial_medium"
                android:textColor="@color/lh_text_primary"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/sans_trial_medium"
                android:textColor="@color/lh_text_primary"
                android:textSize="@dimen/_12sdp" />

        </LinearLayout>

        <!-- Memories card: today's memory (picture, name, number of pictures). Empty: a quiet placeholder. -->
        <FrameLayout
            android:id="@+id/cardMemories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/lh_custom_radius_16"
            android:backgroundTint="@color/lh_home_action_icon_well"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true"
            android:minHeight="@dimen/_84sdp">

            <ImageView
                android:id="@+id/ivMemoryCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_highlight_scrim_bottom" />

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/_6sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/sp_round_logo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMemoryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/sans_trial_semi_bold"
                        android:maxLines="1"
                        android:text="@string/launcher_memories"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:id="@+id/tvMemoryCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/sans_trial_medium"
                        android:maxLines="1"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/lh_ic_arrow"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Middle: the left-edge tab (tap or swipe right to open the gallery
         page) and the "make us your default" card while the app is not the default launcher. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="@dimen/_12sdp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Tab row: the gallery tab on the left edge, the Cleaning report (rocket) tab on the right edge. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/rlQuickAction"
                android:layout_width="@dimen/_56sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/lh_custom_button_round_right"
                android:backgroundTint="@color/lh_bg">
    
                <ImageView
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/sp_round_logo" />
    
            </RelativeLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Photo vault tab: mirrors the gallery tab, opens the vault. -->
            <RelativeLayout
                android:id="@+id/rlVaultAction"
                android:layout_width="@dimen/_56sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/lh_custom_button_round_left"
                android:backgroundTint="@color/lh_bg"
                android:contentDescription="@string/launcher_vault_open">

                <ImageView
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:background="@drawable/bg_launcher_rocket_circle"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/ic_launcher_eye" />

            </RelativeLayout>
        </LinearLayout>

        <include
            android:id="@+id/promoDefault"
            layout="@layout/layout_launcher_default_promo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:visibility="gone" />

    </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/llGoogleFolder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvGoogleFolder"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    app:cardBackgroundColor="@color/lh_bg"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="0dp">

                    <GridLayout
                        android:id="@+id/gvGoogleApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:columnCount="3"
                        android:padding="@dimen/_2sdp" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvGoogle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/sans_trial_medium"
                    android:singleLine="true"
                    tools:text="@string/launcher_folder_google"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10sdp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llToolsFolder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvToolsFolder"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    app:cardBackgroundColor="@color/lh_bg"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="0dp">

                    <GridLayout
                        android:id="@+id/gvToolsApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:columnCount="3"
                        android:padding="@dimen/_2sdp" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvTools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/sans_trial_medium"
                    android:singleLine="true"
                    tools:text="@string/launcher_folder_tools"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10sdp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTopApp1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/ivTopAppIcon1"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvTopAppName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/sans_trial_medium"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10sdp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTopApp2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTopAppIcon2"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/lh_ic_settings_home" />

                <TextView
                    android:id="@+id/tvTopAppName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/sans_trial_medium"
                    android:singleLine="true"
                    android:text="@string/launcher_title"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10sdp" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/ivSwipeUp"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_gravity="center"
            android:contentDescription="@string/launcher_swipe_hint"
            android:layout_margin="@dimen/_12sdp"
            android:rotation="-90"
            android:src="@drawable/lh_ic_arrow"
            app:tint="@android:color/white" />

        <!-- Dock: contacts, dialer, SMS, browser, camera. A slot hides itself when the phone has no such app. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <!-- Contacts (the system Contacts app) starts the dock; hidden when the phone has none. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivAppIconContacts"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:importantForAccessibility="no" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivAppIcon1"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivAppIcon2"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivAppIcon3"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivAppIcon4"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
