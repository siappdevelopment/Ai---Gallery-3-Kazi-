<?xml version="1.0" encoding="utf-8"?>
<!-- A vault folder (design 72) and its selection mode (design 73) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/language_background"
    tools:context=".activity.VaultFolderActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_home_circle_button"
                android:contentDescription="@string/albums_back"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/splash_text_primary" />

            <TextView
                android:id="@+id/tvSelected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="-0.017"
                android:textColor="@color/splash_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Space
                android:id="@+id/topSpace"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/selection_select_all"
                android:textColor="@color/perm_icon_tint"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSelect"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_vault_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/vault_select"
                android:textColor="@color/splash_text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/titleBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.033"
                android:maxLines="2"
                android:textColor="@color/splash_text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/home_text_muted"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvItems"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="1dp"
                android:paddingEnd="1dp"
                android:paddingBottom="100dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/emptyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingTop="60dp"
                android:paddingEnd="30dp"
                android:paddingBottom="60dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_bin_empty_tile"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_vault_folder_open"
                        app:tint="@color/perm_icon_tint" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/vault_folder_empty_title"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/vault_folder_empty_desc"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Floating Unhide / Move / Delete bar while selecting -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_selection_actions"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/actUnhide"
            style="@style/Widget.ThirdGallery.VaultAction">

            <ImageView
                style="@style/Widget.ThirdGallery.VaultActionIcon"
                android:src="@drawable/ic_vault_visibility"
                app:tint="@color/splash_text_primary" />

            <TextView
                style="@style/Widget.ThirdGallery.VaultActionLabel"
                android:text="@string/vault_unhide"
                android:textColor="@color/splash_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actMove"
            style="@style/Widget.ThirdGallery.VaultAction">

            <ImageView
                style="@style/Widget.ThirdGallery.VaultActionIcon"
                android:src="@drawable/ic_drive_file_move"
                app:tint="@color/splash_text_primary" />

            <TextView
                style="@style/Widget.ThirdGallery.VaultActionLabel"
                android:text="@string/vault_move"
                android:textColor="@color/splash_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actDelete"
            style="@style/Widget.ThirdGallery.VaultAction">

            <ImageView
                style="@style/Widget.ThirdGallery.VaultActionIcon"
                android:src="@drawable/ic_delete"
                app:tint="@color/vault_error" />

            <TextView
                style="@style/Widget.ThirdGallery.VaultActionLabel"
                android:text="@string/vault_key_delete"
                android:textColor="@color/vault_error" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
