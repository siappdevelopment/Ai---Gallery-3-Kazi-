<?xml version="1.0" encoding="utf-8"?>
<!-- Design 65: Fingerprint setup -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_vault_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/splash_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:background="@drawable/bg_vault_fingerprint_circle"
                android:importantForAccessibility="no">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_vault_fingerprint"
                    app:tint="@color/brand_pink" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:letterSpacing="-0.035"
                android:text="@string/vault_fp_title"
                android:textColor="@color/splash_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:maxWidth="300dp"
                android:text="@string/vault_fp_desc"
                android:textColor="@color/splash_text_secondary"
                android:textSize="14.5sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnUse"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_vault_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/vault_fp_use"
        android:textColor="@color/white"
        android:textSize="15.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnLater"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_vault_pill_flat"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/vault_fp_later"
        android:textColor="@color/splash_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
