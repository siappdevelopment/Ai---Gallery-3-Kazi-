<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Three overlapping thumbnails (62 x 46) -->
    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="46dp"
        android:importantForAccessibility="no">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivThumb1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="5dp"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.ThirdGallery.Thumb" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivThumb2"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:layout_marginStart="13dp"
            android:layout_marginTop="2dp"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.ThirdGallery.Thumb" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivThumb3"
            android:layout_width="36dp"
            android:layout_height="46dp"
            android:layout_marginStart="26dp"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.ThirdGallery.Thumb" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/splash_text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/home_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_home_pill"
        android:paddingStart="9dp"
        android:paddingTop="4dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp"
        android:textColor="@color/perm_icon_tint"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
