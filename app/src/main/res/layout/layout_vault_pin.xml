<?xml version="1.0" encoding="utf-8"?>
<!-- Designs 61-63 (create, confirm, mismatch) and 66-67 (unlock, wrong PIN): the PIN pad -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_home_circle_button"
            android:contentDescription="@string/albums_back"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/splash_text_primary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_vault_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/splash_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Title, dots and error are centred and scroll on small screens or very large fonts -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_perm_icon_tile"
                android:importantForAccessibility="no">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/perm_icon_tint" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:letterSpacing="-0.03"
                android:textColor="@color/splash_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/splash_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_vault_dot" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="18dp"
                    android:background="@drawable/bg_vault_dot" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="18dp"
                    android:background="@drawable/bg_vault_dot" />

                <View
                    android:id="@+id/dot4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="18dp"
                    android:background="@drawable/bg_vault_dot" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:minHeight="20dp"
                android:textColor="@color/vault_error"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- 3 x 4 keypad; 5dp around every key gives the design's 10dp gaps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:paddingBottom="1dp">

        <LinearLayout style="@style/Widget.ThirdGallery.VaultKeyRow">

            <TextView
                android:id="@+id/key1"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="1" />

            <TextView
                android:id="@+id/key2"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="2" />

            <TextView
                android:id="@+id/key3"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="3" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.ThirdGallery.VaultKeyRow">

            <TextView
                android:id="@+id/key4"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="4" />

            <TextView
                android:id="@+id/key5"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="5" />

            <TextView
                android:id="@+id/key6"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="6" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.ThirdGallery.VaultKeyRow">

            <TextView
                android:id="@+id/key7"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="7" />

            <TextView
                android:id="@+id/key8"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="8" />

            <TextView
                android:id="@+id/key9"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="9" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.ThirdGallery.VaultKeyRow">

            <ImageView
                android:id="@+id/keyFingerprint"
                style="@style/Widget.ThirdGallery.VaultIconKey"
                android:contentDescription="@string/vault_key_fingerprint"
                android:src="@drawable/ic_vault_fingerprint"
                app:tint="@color/brand_pink" />

            <TextView
                android:id="@+id/key0"
                style="@style/Widget.ThirdGallery.VaultKey"
                android:text="0" />

            <ImageView
                android:id="@+id/keyDelete"
                style="@style/Widget.ThirdGallery.VaultIconKey"
                android:contentDescription="@string/vault_key_delete"
                android:src="@drawable/ic_vault_backspace"
                app:tint="@color/splash_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="54dp">

        <TextView
            android:id="@+id/btnForgot"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_vault_pill_flat"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/vault_pin_forgot"
            android:textColor="@color/perm_icon_tint"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
