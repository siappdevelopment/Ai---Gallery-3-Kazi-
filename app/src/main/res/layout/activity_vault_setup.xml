<?xml version="1.0" encoding="utf-8"?>
<!-- Photo vault setup and unlock (designs 60-68): one panel is visible at a time -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/language_background"
    tools:context=".activity.VaultSetupActivity">

    <include
        android:id="@+id/panelIntro"
        layout="@layout/layout_vault_intro" />

    <include
        android:id="@+id/panelPin"
        layout="@layout/layout_vault_pin" />

    <include
        android:id="@+id/panelRecovery"
        layout="@layout/layout_vault_recovery" />

    <include
        android:id="@+id/panelFingerprint"
        layout="@layout/layout_vault_fingerprint" />

    <include
        android:id="@+id/panelForgot"
        layout="@layout/layout_vault_forgot" />
</FrameLayout>
