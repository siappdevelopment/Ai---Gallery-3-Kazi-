<?xml version="1.0" encoding="utf-8"?>
<!-- Recent search pill: history icon + text -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:background="@drawable/bg_search_chip"
    android:clickable="true"
    android:drawablePadding="5dp"
    android:drawableStart="@drawable/ic_history_small"
    android:drawableTint="@color/home_text_muted"
    android:ellipsize="end"
    android:focusable="true"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:paddingStart="10dp"
    android:paddingEnd="14dp"
    android:textColor="@color/splash_text_primary"
    android:textSize="13sp"
    android:textStyle="bold" />
