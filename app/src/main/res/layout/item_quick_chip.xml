<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:background="@drawable/bg_quick_chip"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="11dp"
    android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/ivChipIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        app:tint="@color/perm_icon_tint" />

    <TextView
        android:id="@+id/tvChipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:textColor="@color/splash_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChipCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/home_text_muted"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
