<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/language_background"
    tools:context=".activity.AlbumDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


    <!-- Back and actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_home_circle_button"
            android:contentDescription="@string/albums_back"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/splash_text_primary" />

        <View
            android:id="@+id/topSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/searchBox"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="no"
                android:background="@null"
                android:hint="@string/album_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="60"
                android:maxLines="1"
                android:textColor="@color/splash_text_primary"
                android:textColorHint="@color/home_text_muted"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_clear"
                android:scaleType="center"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/home_text_muted" />
        </LinearLayout>


        <!-- Add photos: only for an app album (a device folder is filled by the files in it) -->
        <ImageButton
            android:id="@+id/btnAddPhotos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_circle_button"
            android:contentDescription="@string/album_add_photos"
            android:scaleType="center"
            android:src="@drawable/ic_library_add"
            android:visibility="gone"
            app:tint="@color/splash_text_primary" />

        <ImageButton
            android:id="@+id/btnSelect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_circle_button"
            android:contentDescription="@string/albums_select"
            android:scaleType="center"
            android:src="@drawable/ic_checklist"
            app:tint="@color/splash_text_primary" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_circle_button"
            android:contentDescription="@string/home_search"
            android:scaleType="center"
            android:src="@drawable/ic_search"
            app:tint="@color/splash_text_primary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/emptyGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="40dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/photo_filter_empty_title"
                android:textColor="@color/splash_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/photo_filter_empty_desc"
                android:textColor="@color/splash_text_secondary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/btnEmptyAdd"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_vault_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="180dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/album_add_photos"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    </LinearLayout>

    <include
        android:id="@+id/selectionBars"
        layout="@layout/view_selection_bars" />
</FrameLayout>
