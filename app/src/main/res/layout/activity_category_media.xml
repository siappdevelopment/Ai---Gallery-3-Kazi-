<?xml version="1.0" encoding="utf-8"?>
<!-- A "Made for you" category: back, select and search on top, then the title row and the photos by day -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/language_background"
    tools:context=".activity.CategoryMediaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_home_circle_button"
                android:contentDescription="@string/albums_back"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/splash_text_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnSelect"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_circle_button"
                android:contentDescription="@string/albums_select"
                android:scaleType="center"
                android:src="@drawable/ic_checklist"
                app:tint="@color/splash_text_primary" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_circle_button"
                android:contentDescription="@string/search_hint"
                android:scaleType="center"
                android:src="@drawable/ic_search"
                app:tint="@color/splash_text_primary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="1dp"
                android:paddingEnd="1dp"
                android:paddingBottom="16dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/emptyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingTop="40dp"
                android:paddingEnd="40dp"
                android:paddingBottom="120dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/category_empty_title"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptyDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/category_empty_desc"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include
        android:id="@+id/selectionBars"
        layout="@layout/view_selection_bars" />
</FrameLayout>
