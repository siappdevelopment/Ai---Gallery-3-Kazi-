<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder of the full-screen native ad (same page as ad_native_full): the top bar (close / Ad / Sponsored), a big media
     block, and the rounded info card (icon, headline, body, chips, button). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/native_full_bg">

    <LinearLayout
        android:id="@+id/shimmerFullContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="64dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_ad_shimmer_block" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_native_full_close" />

                <View
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_native_full_ad_chip" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="@dimen/_56sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:background="@drawable/bg_ad_shimmer_block" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/bg_native_full_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical">

                <View
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/bg_ad_shimmer_block" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ad_shimmer_block" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_ad_shimmer_block" />

            <View
                android:layout_width="@dimen/_150sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_ad_shimmer_block" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:background="@drawable/bg_ad_shimmer_block" />

                <View
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:background="@drawable/bg_ad_shimmer_block" />

                <View
                    android:layout_width="@dimen/_44sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:background="@drawable/bg_ad_shimmer_block" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/bg_ad_shimmer_block" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
