<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/language_background"
    android:orientation="vertical"
    tools:context=".activity.MediaPermissionActivity">

    <!-- Content is centred and scrolls on very large fonts; the button stays pinned below -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/intro_horizontal_padding"
        android:paddingEnd="@dimen/intro_horizontal_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Illustration: two photos and the pink library badge (150 x 130) -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="130dp"
                android:clipChildren="false"
                android:importantForAccessibility="no">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="84dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="18dp"
                    android:rotation="-8"
                    android:scaleType="centerCrop"
                    android:src="@drawable/perm_media_photo_1"
                    app:shapeAppearance="@style/ShapeAppearance.ThirdGallery.IntroTileLarge" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="90dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="46dp"
                    android:layout_marginTop="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/perm_media_photo_2"
                    app:shapeAppearance="@style/ShapeAppearance.ThirdGallery.IntroTileLarge" />

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_perm_badge">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_photo_library"
                        app:tint="@color/white" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="-0.037"
                android:lineSpacingMultiplier="0.95"
                android:text="@string/perm_media_title"
                android:textColor="@color/splash_text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/perm_media_subtitle"
                android:textColor="@color/splash_text_secondary"
                android:textSize="14.5sp" />

            <!-- Three benefit rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_perm_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_grid_view"
                        app:tint="@color/perm_icon_tint" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/perm_media_point_1"
                        android:textColor="@color/splash_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_auto_awesome"
                        app:tint="@color/perm_icon_tint" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/perm_media_point_2"
                        android:textColor="@color/splash_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/perm_icon_tint" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/perm_media_point_3"
                        android:textColor="@color/splash_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
        android:text="@string/language_continue"
        android:textColor="@color/white"
        android:textSize="15.5sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_pink"
        app:cornerRadius="16dp" />
</LinearLayout>
