<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen web view of the Quiz link (Google_ad_Fail_type = Browser) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quizBrowserRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <WebView
        android:id="@+id/quizWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/quizWebProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100" />

    <ImageButton
        android:id="@+id/quizBrowserClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_video_control"
        android:contentDescription="@string/albums_back"
        android:src="@drawable/ic_close"
        app:tint="@color/white"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</FrameLayout>
