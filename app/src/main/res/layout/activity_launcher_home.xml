<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher: a pager (gallery | home) with the app drawer over it -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".launcher.LauncherHomeActivity">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpLauncher"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.thirdgallery.launcher.LauncherDrawerView
        android:id="@+id/appsDrawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
